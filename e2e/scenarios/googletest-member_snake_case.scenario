# Observed: 2596 edits across 61 files apply cleanly and 41-152 renames per TU
# are skipped as collisions, but the rebuild then fails with ~2993 stale-name
# errors in 36 files -- every one of them a member referenced from inside a
# macro. (Before collision skipping landed this was 18081 errors in 52 files.)
REPO=googletest
RULESET=member_snake_case
EXPECT=known_fail
EXPECT_FAIL_PHASE=rebuild
EXPECT_FAIL_REASON="Macro sites: renameAt() (rename_variables_lib.cpp) returns early on Loc.isMacroID(), so uses like GTEST_CHECK_POSIX_SUCCESS_(pthread_mutex_lock(&mutex_)) keep the old name while the declaration is renamed."
