# Test helpers for the code browser.
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:private"])

# A minimal `curl -f`: the smoke tests must not depend on a system curl.
cc_binary(
    name = "http_get",
    srcs = ["http_get.cpp"],
    # Asio's coroutine-era headers, like everything in //code_browser.
    copts = ["-std=c++20"],
    visibility = [
        "//bazel/testdata:__pkg__",
        "//code_browser:__pkg__",
    ],
    deps = [
        "@boost.asio",
        "@boost.beast",
    ],
)
