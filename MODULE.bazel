module(
    name = "cpp_formatting",
    version = "0.1.0",
)

# Good practice to include rules_cc when building C++ with Bzlmod
bazel_dep(name = "rules_cc", version = "0.2.17")

# 1.15.2 is what protobuf's abseil pin resolves the graph to anyway; naming it
# here keeps Bazel's direct-dependency check quiet.
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "rules_shell", version = "0.4.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")

# The symbol index (`cpp_format --emit-index` / `--merge-index`) is serialized
# as protocol buffers.  The module graph resolved protobuf 29.0 transitively
# before this, but that release asks for abseil 20240116.1, which no longer
# compiles with GCC 15 (its container_memory.h uses uintptr_t without
# including <cstdint>), and it references an abseil target the fixed releases
# have removed -- so the two are bumped as a pair by taking the protobuf
# release whose own abseil pin has the fix.
bazel_dep(name = "protobuf", version = "31.1")

# The code browser (//code_browser): an HTTP server on Boost.Beast/Asio over an
# index imported into SQLite.  The three Boost modules pull the rest of Boost in
# transitively; nothing SSL is fetched (boost.asio's ssl flag defaults to off).
# sqlite3 is the BCR amalgamation with default options (thread-safe, no FTS5 --
# the browser's search uses its own trigram table).
bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.beast", version = "1.90.0.bcr.1")
bazel_dep(name = "sqlite3", version = "3.53.4")

# The one zlib every binary links: protobuf's, LLVM's (through the `llvm_zlib`
# shim in //third_party/llvm:extensions.bzl) and the embedded Clang resource
# directory's.  The version is the one protobuf resolves the graph to.
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")

# Transitive dependencies required by the LLVM Bazel overlay's BUILD files.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "apple_support", version = "1.24.1", repo_name = "build_bazel_apple_support")

# The C/C++ toolchain on Linux: hermetic-llvm, a prebuilt Clang with its
# runtimes (compiler-rt, libc++, libunwind) and libc built from source, so no
# compiler, sysroot or standard library comes from the machine -- which is what
# makes remote execution sound: a worker and a workstation produce the same
# bytes.  Not to be confused with the Clang *libraries* the tools link, which
# are still built from source below (`@llvm-project`, 21.1.8); this `@llvm` is
# only what compiles them.
#
# Dev-only, like the registration: a consumer who imports the kit by URL must
# keep the toolchain they chose.
#
# Only the Linux-hosted toolchains are registered, not `@llvm//toolchain:all`.
# macOS and Windows keep the toolchain Bazel finds on the machine: .bazelrc's
# `build:windows` block is written for cl.exe, and neither host has been
# validated against the hermetic one.  (`stage1_*`..`stage3_*` in that package
# are for bootstrapping the compiler from source and are not used.)
bazel_dep(name = "llvm", version = "0.8.21", dev_dependency = True)

# hermetic-llvm links glibc dynamically only: against stubs generated from a
# symbol list, the implementation coming from the machine the binary runs on.
# The release binaries are fully static, so the toolchain is taken from a fork
# that adds what that needs -- glibc 2.44's libc.a, libm.a and startup files
# built from source, selected by a platform constraint (//tools/platforms;
# `--config=minify-<cpu>`):
#
#   https://github.com/geligeli/hermetic-llvm, branch `glibc-static`
#
# The tag is upstream's release plus that branch, so a toolchain bump is: rebase
# the branch onto the new upstream tag, tag it, and change the three lines
# below (`bazel_dep`'s version above is what the fork's MODULE.bazel says and
# is otherwise unused -- an override replaces the registry lookup).  A tarball
# pinned by hash rather than `git_override`: it needs no git on the machine and
# lands in the repository cache.  An override is honoured in the root module
# only, which is where it is wanted.
archive_override(
    module_name = "llvm",
    integrity = "sha256-pGjxdNeDa82AVvZhxMBu9g73r0rYiJWgiZ/gT3zg49o=",
    strip_prefix = "hermetic-llvm-0.8.21-glibc-static.1",
    urls = ["https://github.com/geligeli/hermetic-llvm/archive/refs/tags/v0.8.21-glibc-static.1.tar.gz"],
)

register_toolchains(
    "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
    "@llvm//toolchain:linux_x86_64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_aarch64",
    "@llvm//toolchain:linux_aarch64_to_linux_x86_64",
    dev_dependency = True,
)

# BUILD file maintenance (`bazel run //tools/gazelle`): Gazelle with the C++
# extension derives every cc_* target's deps from its #includes.  Dev-only --
# nothing a consumer of the prebuilt kit builds needs them, and as ordinary
# dependencies they would drag rules_go and a Go SDK into every consumer's
# module graph.
bazel_dep(name = "gazelle", version = "0.50.0", dev_dependency = True)
bazel_dep(name = "gazelle_cc", version = "0.6.0", dev_dependency = True)

# The Gazelle rules are instantiated in a generated repository and aliased from
# //tools/gazelle, so that package loads for a consumer too (see
# //tools/gazelle:extension.bzl).
gazelle_runner = use_extension("//tools/gazelle:extension.bzl", "gazelle_runner", dev_dependency = True)
use_repo(gazelle_runner, "gazelle_runner")

# Clang/LLVM is built from source via LLVM's own Bazel overlay.  The Bazel
# Central Registry only ships llvm-project up to 17.0.4, so newer Clang
# releases (21.1.8 here) are pulled in through a local module extension that
# fetches the monorepo source and runs the upstream `llvm_configure` rule.
llvm = use_extension("//third_party/llvm:extensions.bzl", "llvm")
use_repo(llvm, "iwyu", "llvm-project", "llvm-raw", "llvm_zlib", "llvm_zstd")

# The prebuilt-binary kit's own extension.  This is NOT a dev dependency: the
# kit's .bzl names `@cpp_format_bin//:cpp_format` and
# `@code_browser_bin//:code_browser`, and those labels resolve through *this*
# module's repo mapping even when a consumer imports the kit by URL, so the
# mapping must survive cpp_formatting being a dependency.
#
# There is no `release()` pin here, on purpose.  Nothing in this repository
# uses the prebuilt binary -- its own demo, tests and dogfooding all build from
# source -- and as a dependency this module must not contribute a pin: the
# consumer's is the only one that may win, and a stale one here would hand them
# a binary older than the aspect driving it.  (There used to be one, issued
# through a second `dev_dependency = True` proxy, because the extension failed
# when evaluated without a tag and `bazel mod deps` / `bazel mod tidy` evaluate
# every extension.  The repositories now fail when *fetched* instead.)
cpp_format = use_extension("//bazel/integration:extensions.bzl", "cpp_format")
use_repo(cpp_format, "code_browser_bin", "cpp_format_bin")
