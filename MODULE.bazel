module(name = "cpp_formatting", version = "0.1.0")

# Good practice to include rules_cc when building C++ with Bzlmod
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "googletest", version = "1.14.0.bcr.1")
bazel_dep(name = "rules_shell", version = "0.4.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")

# Transitive dependencies required by the LLVM Bazel overlay's BUILD files.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "apple_support", version = "1.24.1", repo_name = "build_bazel_apple_support")

# Clang/LLVM is built from source via LLVM's own Bazel overlay.  The Bazel
# Central Registry only ships llvm-project up to 17.0.4, so newer Clang
# releases (19.1.7 here) are pulled in through a local module extension that
# fetches the monorepo source and runs the upstream `llvm_configure` rule.
llvm = use_extension("//third_party/llvm:extensions.bzl", "llvm")
use_repo(llvm, "llvm-project", "llvm-raw", "llvm_zlib", "llvm_zstd")
