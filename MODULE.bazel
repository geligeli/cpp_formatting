module(
    name = "cpp_formatting",
    version = "0.1.0",
)

# Good practice to include rules_cc when building C++ with Bzlmod
bazel_dep(name = "rules_cc", version = "0.2.17")

# 1.15.2 is what protobuf's abseil pin resolves the graph to anyway; naming it
# here keeps Bazel's direct-dependency check quiet.
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "rules_shell", version = "0.4.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")

# The symbol index (`cpp_format --emit-index` / `--merge-index`) is serialized
# as protocol buffers.  The module graph resolved protobuf 29.0 transitively
# before this, but that release asks for abseil 20240116.1, which no longer
# compiles with GCC 15 (its container_memory.h uses uintptr_t without
# including <cstdint>), and it references an abseil target the fixed releases
# have removed -- so the two are bumped as a pair by taking the protobuf
# release whose own abseil pin has the fix.
bazel_dep(name = "protobuf", version = "31.1")

# The code browser (//code_browser): an HTTP server on Boost.Beast/Asio over an
# index imported into SQLite.  The three Boost modules pull the rest of Boost in
# transitively; nothing SSL is fetched (boost.asio's ssl flag defaults to off).
# sqlite3 is the BCR amalgamation with default options (thread-safe, no FTS5 --
# the browser's search uses its own trigram table).
bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.beast", version = "1.90.0.bcr.1")
bazel_dep(name = "sqlite3", version = "3.53.4")

# The one zlib every binary links: protobuf's, LLVM's (through the `llvm_zlib`
# shim in //third_party/llvm:extensions.bzl) and the embedded Clang resource
# directory's.  The version is the one protobuf resolves the graph to.
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")

# Transitive dependencies required by the LLVM Bazel overlay's BUILD files.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "apple_support", version = "1.24.1", repo_name = "build_bazel_apple_support")

# BUILD file maintenance (`bazel run //tools/gazelle`): Gazelle with the C++
# extension derives every cc_* target's deps from its #includes.  Dev-only --
# nothing a consumer of the prebuilt kit builds needs them, and as ordinary
# dependencies they would drag rules_go and a Go SDK into every consumer's
# module graph.
bazel_dep(name = "gazelle", version = "0.50.0", dev_dependency = True)
bazel_dep(name = "gazelle_cc", version = "0.6.0", dev_dependency = True)

# Clang/LLVM is built from source via LLVM's own Bazel overlay.  The Bazel
# Central Registry only ships llvm-project up to 17.0.4, so newer Clang
# releases (21.1.8 here) are pulled in through a local module extension that
# fetches the monorepo source and runs the upstream `llvm_configure` rule.
llvm = use_extension("//third_party/llvm:extensions.bzl", "llvm")
use_repo(llvm, "iwyu", "llvm-project", "llvm-raw", "llvm_zlib", "llvm_zstd")

# The prebuilt-binary kit's own extension, used through two proxies.  The
# `use_extension`/`use_repo` pair is NOT a dev dependency: the kit's .bzl names
# `@cpp_format_bin//:cpp_format`, and that label resolves through *this*
# module's repo mapping even when a consumer imports the kit by URL, so the
# mapping must survive cpp_formatting being a dependency.  The `release()` pin
# IS one: as a dependency this module must not contribute a pin at all -- the
# consumer's is the only one that may win, and a stale one here would download
# a binary older than the aspect driving it.  Bazel merges both proxies into
# one usage and drops the dev one when this module is not the root, which is
# exactly the split wanted (a tag cannot carry `dev_dependency` itself).  The
# pin therefore only matters when this repo is the root module; it names the
# latest release that carries every flag the in-tree aspect passes, and is
# bumped after each aspect change ships.
cpp_format = use_extension("//bazel/integration:extensions.bzl", "cpp_format")
use_repo(cpp_format, "cpp_format_bin")

cpp_format_dev = use_extension(
    "//bazel/integration:extensions.bzl",
    "cpp_format",
    dev_dependency = True,
)
cpp_format_dev.release(
    version = "20260913-a0a8896",
    # Optional but recommended for reproducible CI — pin per-asset hashes:
    # sha256 = {"cpp_format-linux-x86_64": "…"},
)
