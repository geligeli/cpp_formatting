# Patches applied to the hermetic-llvm module (`@llvm`, the C/C++ toolchain) by
# the `single_version_override` in //:MODULE.bazel.
#
#   glibc_static.patch           the change itself: a rule that builds glibc's
#                                libc.a / libm.a / startup files from source,
#                                the `@llvm//constraints/glibc_linkage:static`
#                                constraint that selects them, the generator
#                                and the reference-build script.
#   glibc_static_<arch>.patch    generated data, one per architecture: the
#                                manifest of compile commands and the files of
#                                glibc's build tree they read.  Regenerate with
#                                3rd_party/libc/glibc/static/reference_build.sh
#                                and gen_manifest.py; never edit by hand.
exports_files(glob(["*.patch"]))
