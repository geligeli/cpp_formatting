+  case 8: /* exp: exp ADDOP2 exp  */
+          {
+	    (yyval.exp) = new_exp_2 ((yyvsp[-1].op), (yyvsp[-2].exp), (yyvsp[0].exp));
+	  }
+    break;
+
+  case 9: /* exp: exp MULOP2 exp  */
+          {
