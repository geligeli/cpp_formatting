# //code_browser is C++20 (Boost.Asio coroutines).  The BCR boost.asio module
# compiles Asio's separately-compiled source with the toolchain's default
# standard (C++17 here), which leaves out impl/awaitable.ipp -- the coroutine
# launch functions -- and the browser then fails to link.  Compile that one
# external file with C++20 too; nothing else in the build sees the flag.
build --per_file_copt=external/boost\.asio.*@-std=c++20

# Pick up build:linux / build:macos / build:windows sections below based on
# the host platform.
common --enable_platform_specific_config

# Match LLVM's no-RTTI build (cl.exe doesn't understand -fno-rtti, so the
# Windows build uses /GR- instead).
build:linux --cxxopt=-fno-rtti
build:macos --cxxopt=-fno-rtti
build:windows --cxxopt=/GR-

# MSVC's traditional preprocessor cannot handle the empty macro arguments in
# LLVM's generated Options.inc (error C2365 'OPT_': redefinition); use the
# conforming preprocessor on Windows.
build:windows --cxxopt=/Zc:preprocessor
build:windows --cxxopt=/wd5105

# The rest of the MSVC flag set LLVM's own build uses, from
# llvm/cmake/modules/HandleLLVMOptions.cmake: building LLVM with Bazel instead
# of CMake means reproducing the flags its source expects.
#
#   /permissive-     conformance mode.  MSVC defaults to /permissive before
#                    C++20, whose non-conforming lookup binds
#                    `friend class TrailingObjects;` to the namespace-level
#                    template rather than the base's injected-class-name and
#                    then rejects it (C2990 in TrieRawHashMap.cpp, new in
#                    LLVM 21).  Upstream declined a source workaround for the
#                    identical error elsewhere (llvm/llvm-project#163865),
#                    pointing at this flag instead.
#   /Zc:__cplusplus  without it MSVC reports __cplusplus as 199711L whatever
#                    /std: says, so headers that branch on it pick C++98 paths.
#   /Zc:inline       drop unreferenced internal-linkage functions.
#   /bigobj          LLVM's larger objects exceed the default section limit.
#
# Each is given twice: LLVM is compiled in both configurations -- the target one
# for the binary, the exec one for tablegen and the other build tools -- and
# --cxxopt reaches only the former.  Miss the host copy and the same file fails
# again, just marked "[for tool]".
build:windows --cxxopt=/permissive-
build:windows --host_cxxopt=/permissive-
build:windows --cxxopt=/Zc:__cplusplus
build:windows --host_cxxopt=/Zc:__cplusplus
build:windows --cxxopt=/Zc:inline
build:windows --host_cxxopt=/Zc:inline
build:windows --cxxopt=/bigobj
build:windows --host_cxxopt=/bigobj
build:windows --host_cxxopt=/Zc:preprocessor

# link.exe reports unresolved externals one line per symbol, which for a failed
# static link of LLVM runs to well over the 1 MB Bazel prints by default -- the
# whole diagnostic then gets replaced by "exceeds maximum size ... skipping",
# leaving a bare "Exit 1120" and nothing to act on.
build:windows --experimental_ui_max_stdouterr_bytes=33554432

# We link the Clang libraries statically, so tell them so.  clang/Support/
# Compiler.h (new in LLVM 21) annotates exported entities with CLANG_ABI, which
# on Windows expands to __declspec(dllimport) unless CLANG_BUILD_STATIC is
# defined -- and ASTMatchersMacros.h puts CLANG_ABI on the `extern const`
# declaration behind every AST matcher.  Statically linking against hundreds of
# dllimport'd matchers is thousands of unresolved __imp_* externals (LNK1120).
# LLVM's own half of this is already inert: LLVM_ABI is additionally gated on
# LLVM_ENABLE_LLVM_EXPORT_ANNOTATIONS, which the Bazel overlay sets only in
# posix_defines.  Clang's is gated on CLANG_BUILD_STATIC alone, and the overlay
# never defines it.
build:windows --cxxopt=/DCLANG_BUILD_STATIC
build:windows --host_cxxopt=/DCLANG_BUILD_STATIC

# Silence the MSVC warnings LLVM headers trigger in volume (C4624 alone fired
# ~10k times per build); LLVM's own CMake build suppresses the same set on
# MSVC. Kept to warnings actually observed in CI logs.
build:windows --cxxopt=/wd4244
build:windows --cxxopt=/wd4267
build:windows --cxxopt=/wd4319
build:windows --cxxopt=/wd4624
build:windows --cxxopt=/wd4805
build:windows --define=protobuf_allow_msvc=true

build:minify -c opt
build:minify --copt=-ffunction-sections
build:minify --copt=-fdata-sections
build:minify --copt=-flto
build:minify --copt=-Os
build:minify --cxxopt=-fno-exceptions
# ... except where exceptions are the error model: Boost.Asio reports every
# failure by throwing, so //code_browser (the other release binary) and the
# Boost sources it compiles get them back.  A --per_file_copt lands after every
# --cxxopt on the command line, and the last -f[no-]exceptions wins.  Everything
# else -- LLVM, protobuf, abseil -- stays without, so those objects are shared
# between the two binaries in one release build.  Nothing throws *through*
# them: the frames between Asio's throw and http_server's catch are all Boost's
# and code_browser's own.
build:minify --per_file_copt=external/boost\..*,code_browser/.*@-fexceptions
build:minify --cxxopt=-fno-rtti
build:minify --linkopt=-flto
build:minify --linkopt=-fno-asynchronous-unwind-tables
build:minify --linkopt=-Wl,--gc-sections
build:minify --linkopt=-Wl,--strip-all
build:minify --platform_suffix=-minify

# Fully static, against glibc.  The hermetic toolchain links glibc dynamically
# by default -- against version stubs, with no libc.a to link -- so "static" is
# a property of the *platform*: //tools/platforms:linux_*_glibc_static selects
# glibc 2.44's libc.a/libm.a and startup files, built from source by the fork
# of the toolchain MODULE.bazel names, and the toolchain then links -static(-pie)
# the way it does for musl.  That replaces `--features=fully_static_link` and
# the system Clang (`--action_env=CC=clang`) this config used to need.  A
# platform names one CPU, so the release workflow picks the config by runner.
build:minify-x86_64 --config=minify
build:minify-x86_64 --platforms=//tools/platforms:linux_x86_64_glibc_static
build:minify-aarch64 --config=minify
build:minify-aarch64 --platforms=//tools/platforms:linux_aarch64_glibc_static

# Sanitizers: `bazel test --config=asan //...` (or tsan / ubsan).
#
# Everything in the target configuration is instrumented -- LLVM, protobuf and
# Boost included -- because most of what these tools can get wrong is a lifetime
# error on something of Clang's (a StringRef into a buffer that went away, an
# AST node outliving its ASTContext), and the faulting access is then as likely
# to be inside LLVM as in our code.  So the first build under each config is a
# from-source LLVM build, and each config gets a --platform_suffix: its outputs
# live in their own bazel-out directory and switching configs does not evict
# anything.  Build tools (tablegen, protoc, the aspects' cpp_format) are in the
# exec configuration, which --copt does not reach, and stay uninstrumented.
#
# -O1 rather than the fastbuild -O0: instrumented -O0 LLVM is too slow to run
# the rename tests, and the sanitizers' documentation recommends it.  -g1 is
# line tables and function names -- enough for a symbolized report -- without
# the multi-gigabyte objects full debug info makes of LLVM.
build:sanitizer --copt=-O1
build:sanitizer --copt=-g1
build:sanitizer --copt=-fno-omit-frame-pointer
build:sanitizer --strip=never
# RTTI on, overriding build:linux's -fno-rtti (a --config given on the command
# line expands after the platform section, and the last -f[no-]rtti wins).  The
# normal build is -fno-rtti only to match LLVM's, and here LLVM is built from
# source in this very configuration, so there is nothing to match.  It is not
# optional under ASan: without RTTI Clang emits a private weak copy of the
# typeinfo of every type a TU throws (std::bad_function_call, bad_variant_access,
# ...), the toolchain's instrumented libc++ defines the same typeinfo strongly
# inside a COMDAT group of the same signature, and lld rejects the mix
# ("relocation refers to a symbol in a discarded section: typeinfo for ...").
build:sanitizer --cxxopt=-frtti
# Only what the tests need.  `//...` also holds //tools/gazelle, a Go program
# whose C link step gets the sanitizer runtime but not libunwind
# ("undefined symbol: _Unwind_Resume"), and sanitizing it would say nothing.
test:sanitizer --build_tests_only

# AddressSanitizer (+ LeakSanitizer, which it includes on Linux).
build:asan --config=sanitizer
build:asan --platform_suffix=asan
# The toolchain's switch, not --copt=-fsanitize=address: it builds compiler-rt's
# runtime from source (there is no prebuilt one to link) and adds the flags
# itself -- to everything except its own startup files and runtimes, which a
# --copt would reach too (lld then rejects the instrumented crtend.o: "a section
# asan_globals with SHF_LINK_ORDER should not refer a non-regular section").
# Linux only, like the toolchain registration in MODULE.bazel.
build:asan --@llvm//config:asan

# ThreadSanitizer: the TU driver's worker pool (--jobs) and the code browser's
# multi-threaded io_context are what it is for.
build:tsan --config=sanitizer
build:tsan --platform_suffix=tsan
build:tsan --@llvm//config:tsan
# Compile anywhere, but *run* the tests on this machine.  A TSan binary needs a
# particular memory layout and, on a kernel with high mmap entropy (Ubuntu
# 24.04's vm.mmap_rnd_bits=32), gets it by re-executing itself with ASLR off --
# which a remote-execution worker's container does not allow ("FATAL:
# ThreadSanitizer: encountered an incompatible memory layout but was unable to
# disable ASLR").  It fails or not depending on where the kernel happened to
# map things, i.e. as a flake.
test:tsan --modify_execution_info=TestRunner=+no-remote-exec

# UndefinedBehaviorSanitizer.  Without -fno-sanitize-recover a finding is a line
# on stderr and a passing test.  Nothing is switched off any more: `vptr` needed
# RTTI, which build:sanitizer now turns on, and the three null checks were off
# only because they make *GCC* drop -fdelete-null-pointer-checks, after which
# abseil's `&function == nullptr` in a constexpr does not compile -- the
# toolchain is Clang now.
build:ubsan --config=sanitizer
build:ubsan --platform_suffix=ubsan
build:ubsan --@llvm//config:ubsan
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1

# There is no msan config yet.  It used to be out of reach -- MemorySanitizer
# needs an instrumented C++ standard library, which the system libstdc++ is not
# -- but the hermetic toolchain builds one (--@llvm//config:msan); it has just
# not been tried here.

# Code coverage: `bazel coverage //...`, report in
# bazel-out/_coverage/_coverage_report.dat (LCOV).  See docs/build.md.
#
# Clang's source-based coverage, not the gcov format Bazel picks by default
# (the toolchain has no gcov to read that back with), turned into LCOV by
# llvm-cov inside each test action.
coverage --experimental_use_llvm_covmap
coverage --experimental_generate_llvm_lcov
coverage --combined_report=lcov
# Our code only.  The default filter is derived from the test targets named on
# the command line, so `//...` would also take in //bazel/testdata and //tools.
# The two `tools` packages are test helpers (http_get, apply_patch).
coverage --instrumentation_filter=^//(cpp_formatting|code_browser)[/:],-^//(cpp_formatting|code_browser)/tools[/:]
# The filter decides what is *reported*, not what is compiled instrumented: the
# toolchain's llvm_coverage_map_format feature puts -fprofile-instr-generate
# -fcoverage-mapping on every compile in the configuration (only the gcov
# format is gated per target), so LLVM, protobuf, zlib, Boost and sqlite all
# carried counters -- LLVM's bumped non-atomically from the TU driver's worker
# threads.  Nor can a per-file copt take them off again: the toolchain appends
# feature flags after the source file, behind every copt.  So the feature is
# off, and the flags are given per file to the two packages instead.  A
# per-file regex is tried against the source's label as well as its path;
# `(//)?` and `[/:]` spell both.  -fprofile-update=atomic: the worker threads
# and the browser's io_context race on the counters too, and llvm-cov, which
# derives many line counts by subtracting one counter from another, then
# reported negative ones ("invalid number on DA line
# DA:281,18446744073709551577").  The link needs the flag for the profile
# runtime.
#
# -fprofile-continuous + LLVM_PROFILE_CONTINUOUS_MODE: the counters live in
# the mmapped .profraw file itself rather than being written out by an atexit
# handler, so a process that never reaches exit() -- SIGKILLed, crashed, or
# leaving through _exit() as a gtest death test's child does -- still counts.
# The shell tests run our binaries as subprocesses (one .profraw each, merged
# with every binary in the test's data as an llvm-cov object); without this, a
# server a test kills with SIGKILL contributes nothing (tried: 0 files, against
# 135 lines of http_server.cpp with it).  bazel_tools' collector appends the
# %c the mode needs to LLVM_PROFILE_FILE when the variable is set.
coverage --features=-llvm_coverage_map_format
coverage --per_file_copt=^(//)?(cpp_formatting|code_browser)[/:],-^(//)?(cpp_formatting|code_browser)/tools[/:]@-fprofile-instr-generate,-fcoverage-mapping,-fprofile-update=atomic,-fprofile-continuous
coverage --linkopt=-fprofile-instr-generate
coverage --test_env=LLVM_PROFILE_CONTINUOUS_MODE=1
# Bazel 8's built-in cc_test takes the paths of llvm-profdata and llvm-cov only
# from a toolchain's legacy `tool_paths`, which a rules-based toolchain like
# hermetic-llvm leaves empty -- so collect_cc_coverage.sh fails with
# "COVERAGE_GCOV_PATH: unbound variable" and every test reports nothing.  Hand
# them over directly: the collector runs in the exec root, where the
# toolchain's coverage_files put both binaries.  COVERAGE_GCOV_PATH is the
# *profdata* tool here -- that is what bazel_tools' collector merges the
# .profraw files with.  The repository name carries no version (an LLVM bump
# keeps it) but does carry the exec CPU: x86_64 only, like CI and the RBE
# workers.
coverage --test_env=COVERAGE_GCOV_PATH=external/llvm++llvm_toolchain_minimal+llvm-toolchain-minimal-linux-amd64/bin/llvm-profdata
coverage --test_env=LLVM_COV=external/llvm++llvm_toolchain_minimal+llvm-toolchain-minimal-linux-amd64/bin/llvm-cov

# cpp_format lint: run the aspect over the build graph and materialise each
# target's edit-record JSON (see bazel/cpp_format.bzl).  The failing lint gate
# is `tools/cpp_format.sh check [pattern]`; this config just builds the records
# (e.g. `bazel build --config=lint //bazel/testdata:demo`) for inspection/CI.
build:lint --aspects=//bazel:cpp_format.bzl%cpp_format_aspect
build:lint --output_groups=+cpp_format_edits

# Symbol index: the same, for the per-file index units (e.g. `bazel build
# --config=index //bazel/testdata/...`).  The merged index of a target pattern
# is `tools/cpp_format.sh index`; `tools/cpp_format.sh browse` serves it.
# The .proto files are the second producer's (bazel/proto_index.bzl), which
# only proto_library targets get anything from.
build:index --aspects=//bazel:cpp_format.bzl%cpp_index_aspect,//bazel:proto_index.bzl%proto_index_aspect
build:index --output_groups=+cpp_index,+proto_index

# Personal, machine-local overrides.  Last import wins, so anything in here
# takes precedence over the settings above.
try-import %workspace%/.bazelrc.local
