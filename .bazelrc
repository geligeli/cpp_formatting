# Bazel caches
#
# The devcontainer bind-mounts the host's shared caches at /bazel-cache/disk and
# /bazel-cache/repo (see .devcontainer/devcontainer.json) and points
# --disk_cache / --repository_cache at them from /etc/bazel.bazelrc inside the
# image.  Those paths are deliberately *not* set here: this file is also read by
# native Linux/macOS/Windows builds, where /bazel-cache does not exist and Bazel
# would fail trying to create it.  Command-line flags (CI passes its own
# --disk_cache=/--repository_cache=) override the container defaults.
#
# To point Bazel at a cache of your own, put the flags in .bazelrc.local
# (gitignored, imported at the bottom of this file):
#
#   build --disk_cache=/path/to/disk
#   common --repository_cache=/path/to/repo

build --spawn_strategy=local

# Pick up build:linux / build:macos / build:windows sections below based on
# the host platform.
common --enable_platform_specific_config

# Match LLVM's no-RTTI build (cl.exe doesn't understand -fno-rtti, so the
# Windows build uses /GR- instead).
build:linux --cxxopt=-fno-rtti
build:macos --cxxopt=-fno-rtti
build:windows --cxxopt=/GR-

# MSVC's traditional preprocessor cannot handle the empty macro arguments in
# LLVM's generated Options.inc (error C2365 'OPT_': redefinition); use the
# conforming preprocessor on Windows.
build:windows --cxxopt=/Zc:preprocessor
build:windows --cxxopt=/wd5105

# Silence the MSVC warnings LLVM headers trigger in volume (C4624 alone fired
# ~10k times per build); LLVM's own CMake build suppresses the same set on
# MSVC. Kept to warnings actually observed in CI logs.
build:windows --cxxopt=/wd4244
build:windows --cxxopt=/wd4267
build:windows --cxxopt=/wd4319
build:windows --cxxopt=/wd4624
build:windows --cxxopt=/wd4805

build:minify -c opt
build:minify --copt=-ffunction-sections
build:minify --copt=-fdata-sections
build:minify --copt=-flto
build:minify --copt=-Os
build:minify --cxxopt=-fno-exceptions
build:minify --cxxopt=-fno-rtti
build:minify --linkopt=-flto
build:minify --linkopt=-fno-ident
build:minify --linkopt=-fno-asynchronous-unwind-tables
build:minify --linkopt=-Wl,--gc-sections
build:minify --linkopt=-Wl,--strip-all
build:minify --action_env=CC=clang
build:minify --action_env=CXX=clang++
build:minify --features=fully_static_link
build:minify --platform_suffix=-minify

# cpp_format lint: run the aspect over the build graph and materialise each
# target's edit-record JSON (see bazel/cpp_format.bzl).  The failing lint gate
# is `bazel test //path:<name>.check`; this config just builds the records
# (e.g. `bazel build --config=lint //bazel/testdata:demo`) for inspection/CI.
build:lint --aspects=//bazel:cpp_format.bzl%cpp_format_aspect
build:lint --output_groups=+cpp_format_edits

# Personal, machine-local overrides.  Last import wins, so anything in here
# takes precedence over the settings above.
try-import %workspace%/.bazelrc.local
