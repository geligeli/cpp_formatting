load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Exercises the in-repo, built-from-source aspects (not the prebuilt-binary kit
# under bazel/integration/), so this demo -- and the :format_check_test gate
# that CI runs -- always exercises the tool exactly as it is in this tree.  The
# aspects' driver is bazel/integration/cpp_format.sh, which cannot run inside a
# Bazel test; aspect_outputs.bzl puts their outputs in front of one instead.
load(
    ":aspect_outputs.bzl",
    "cpp_compile_commands_fragments",
    "cpp_format_records",
    "cpp_index_units",
    "proto_index_units",
)

# A small first-party cc_library used to exercise the cpp_format Bazel
# integration end to end: a member the `member -> snake_case` rule renames
# (Widget::itemCount) plus a header-only template whose dependent token
# (`w.itemCount`) is resolved across TUs by the aggregation phase.
cc_library(
    name = "demo",
    srcs = ["demo.cpp"],
    hdrs = ["demo.h"],
    includes = ["."],
    deps = [":budget"],
)

# A header-only library: it lists no source the aspect would give an action to,
# so it takes the aspect's early return.  Its members are renamed by the TUs
# that include it, and it writes an empty manifest rather than no manifest at
# all -- see budget.h.
cc_library(
    name = "budget",
    hdrs = ["budget.h"],
    includes = ["."],
)

# A dependent target that only *uses* Widget::item_count_.  Exercises the
# cross-target path: the aspect runs one action per source file, each parsing
# only that file, so this file's action must be told (via --owned-files) that
# the dep's headers are renameable, or the use site here would be left behind
# when the member is renamed.
cc_binary(
    name = "demo_main",
    srcs = ["demo_main.cpp"],
    deps = [":demo"],
)

# Test code, as far as the index is concerned: a testonly header-only library
# and a cc_test.  The index aspect marks the files of both `testonly` (see
# index_test.sh).  Not in _DEMO: the format fixtures stay as they were.
cc_library(
    name = "demo_testing",
    testonly = True,
    hdrs = ["demo_testing.h"],
    includes = ["."],
    deps = [":demo"],
)

cc_test(
    name = "demo_test",
    size = "small",
    srcs = ["demo_test.cpp"],
    deps = [
        ":demo",
        ":demo_testing",
    ],
)

_DEMO = [
    ":budget",
    ":demo",
    ":demo_main",
]

# The lint gate over the demo targets: every per-file edit record the aspect
# emits for them, merged by `aggregate_edits --check`, which exits 1 if any
# edit would be made.  The fixture conforms to //:cpp_format.yaml, so it passes;
# `cpp_format.sh check //bazel/testdata/...` is the same gate from outside.
cpp_format_records(
    name = "format_records",
    deps = _DEMO,
)

sh_test(
    name = "format_check_test",
    srcs = ["aggregate_check_test.sh"],
    args = [
        "$(location //cpp_formatting:aggregate_edits)",
        "$(locations :format_records)",
    ],
    data = [
        ":format_records",
        "//cpp_formatting:aggregate_edits",
    ],
)

# index.pb: the merged symbol index of the demo targets -- every symbol's
# declarations, definitions and references across them, as byte ranges.  One
# unit per translation unit from the index aspect, merged as `cpp_format.sh
# index` merges them.
cpp_index_units(
    name = "index_units",
    testonly = True,  # it depends on demo_test
    deps = [
        ":demo",
        ":demo_main",
        ":demo_test",
    ],
)

genrule(
    name = "index",
    testonly = True,
    srcs = [":index_units"],
    outs = ["index.pb"],
    cmd = "$(execpath //cpp_formatting:cpp_format) --merge-index --output=$@ $(SRCS)",
    tools = ["//cpp_formatting:cpp_format"],
    # //code_browser:smoke_test serves this index over a copy of the sources.
    visibility = ["//code_browser:__pkg__"],
)

exports_files(
    [
        "budget.h",
        "demo.cpp",
        "demo.h",
        "demo_main.cpp",
        "demo_test.cpp",
        "demo_testing.h",
        "inventory_user.cpp",
        "proto/inventory.proto",
        "proto/unit.proto",
    ],
    visibility = ["//code_browser:__pkg__"],
)

# The index across two languages.  A .proto is indexed by a producer of its
# own (the proto_index aspect), which also anchors each message, field and
# enumerator on the bytes of the generated header that came from it -- as
# protoc itself reports them; the C++ aspect indexes inventory_user.cpp knowing
# nothing about protos; and the merge links every generated C++ symbol to what
# it was generated from.  unit_proto strips its import prefix, so its file
# reaches the tools as a `_virtual_imports` symlink and its header sits next
# to that, while the index must still call it bazel/testdata/proto/unit.proto.
proto_library(
    name = "unit_proto",
    srcs = ["proto/unit.proto"],
    strip_import_prefix = "/bazel/testdata",
)

proto_library(
    name = "inventory_proto",
    srcs = ["proto/inventory.proto"],
    deps = [":unit_proto"],
)

cc_proto_library(
    name = "unit_cc_proto",
    deps = [":unit_proto"],
)

cc_proto_library(
    name = "inventory_cc_proto",
    deps = [":inventory_proto"],
)

cc_library(
    name = "inventory_user",
    srcs = ["inventory_user.cpp"],
    deps = [
        ":inventory_cc_proto",
        ":unit_cc_proto",
    ],
)

cpp_index_units(
    name = "inventory_cpp_units",
    deps = [":inventory_user"],
)

proto_index_units(
    name = "inventory_proto_units",
    deps = [":inventory_proto"],
)

genrule(
    name = "inventory_index",
    srcs = [
        ":inventory_cpp_units",
        ":inventory_proto_units",
    ],
    outs = ["inventory_index.pb"],
    cmd = "$(execpath //cpp_formatting:cpp_format) --merge-index --output=$@ $(SRCS)",
    tools = ["//cpp_formatting:cpp_format"],
    visibility = ["//code_browser:__pkg__"],
)

# From the C++ use to the .proto and back, over the real protoc and the real
# cc_proto_library: what pins that protoc's annotation ranges are the ranges
# Clang declares the generated symbols on.
sh_test(
    name = "proto_index_test",
    srcs = ["proto_index_test.sh"],
    args = [
        "$(location :inventory_index.pb)",
        "$(location //cpp_formatting:cpp_format)",
        "$(location proto/inventory.proto)",
        "$(location proto/unit.proto)",
        "$(location inventory_user.cpp)",
    ],
    data = [
        "inventory_user.cpp",
        "proto/inventory.proto",
        "proto/unit.proto",
        ":inventory_index.pb",
        "//cpp_formatting:cpp_format",
    ],
)

exports_files(
    ["aggregate_check_test.sh"],
    visibility = [":__subpackages__"],
)

# Reads the merged index back with `cpp_format --dump-index` and asserts the
# cross-target reference: demo_main.cpp's use of Widget::item_count_ resolves
# to the same symbol as its definition in demo.h, both under exec-root-relative
# paths.
sh_test(
    name = "index_test",
    srcs = ["index_test.sh"],
    args = [
        "$(location :index.pb)",
        "$(location //cpp_formatting:cpp_format)",
        "$(location demo.h)",
        "$(location demo_main.cpp)",
    ],
    data = [
        "demo.h",
        "demo_main.cpp",
        ":index.pb",
        "//cpp_formatting:cpp_format",
    ],
)

# Merges the demo targets' compile_commands fragments with cpp_format.sh's own
# merge_compile_commands (the script is sourced for it) and has cpp_format
# consume the resulting compile_commands.json as its compilation database.
cpp_compile_commands_fragments(
    name = "compile_commands_fragments",
    deps = _DEMO,
)

sh_test(
    name = "compile_commands_test",
    srcs = ["compile_commands_test.sh"],
    args = [
        "$(location //bazel/integration:cpp_format.sh)",
        "$(location //cpp_formatting:cpp_format)",
        "$(location //:cpp_format.yaml)",
        "$(location demo_main.cpp)",
        "$(locations :compile_commands_fragments)",
    ],
    data = [
        "demo_main.cpp",
        ":compile_commands_fragments",
        "//:cpp_format.yaml",
        "//bazel/integration:cpp_format.sh",
        "//cpp_formatting:cpp_format",
    ],
    # The database's `directory` is the *execution root* and its `-c`/`-isystem`
    # paths are relative to it, which is what an editor gets.  A sandbox (or a
    # remote worker) stages only this test's declared inputs under a directory
    # of the same shape, so the entry's source and the toolchain's headers are
    # not there; run in the real one.
    tags = ["local"],
)

# The `bazel coverage` flags `cpp_format.sh coverage` derives from the
# workspace's C++ toolchain, from the script's helpers (sourced, like
# compile_commands_test does).
sh_test(
    name = "coverage_flags_test",
    size = "small",
    srcs = ["coverage_flags_test.sh"],
    args = ["$(location //bazel/integration:cpp_format.sh)"],
    data = ["//bazel/integration:cpp_format.sh"],
)
