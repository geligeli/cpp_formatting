load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Uses the in-repo, built-from-source rules (not the prebuilt-binary kit under
# bazel/integration/), so this demo — and the `//bazel/testdata:format.check`
# gate that CI runs — always exercises the tool exactly as it is in this tree.
# The kit tracks a pinned published binary, which necessarily lags in-tree
# aspect changes (e.g. --owned-files, --aggregate --records-from); re-point at
# the kit once a release that carries the current flag set is published.
load("//bazel:cpp_format.bzl", "cpp_format_targets", "cpp_index_targets")

# A small first-party cc_library used to exercise the cpp_format Bazel
# integration end to end: a member the `member -> snake_case` rule renames
# (Widget::itemCount) plus a header-only template whose dependent token
# (`w.itemCount`) is resolved across TUs by the aggregation phase.
cc_library(
    name = "demo",
    srcs = ["demo.cpp"],
    hdrs = ["demo.h"],
    includes = ["."],
    deps = [":budget"],
)

# A header-only library: it lists no source the aspect would give an action to,
# so it takes the aspect's early return.  Its members are renamed by the TUs
# that include it, and it writes an empty manifest rather than no manifest at
# all -- see budget.h.
cc_library(
    name = "budget",
    hdrs = ["budget.h"],
    includes = ["."],
)

# A dependent target that only *uses* Widget::item_count_.  Exercises the
# cross-target path: the aspect runs one action per source file, each parsing
# only that file, so this file's action must be told (via --owned-files) that
# the dep's headers are renameable, or the use site here would be left behind
# when the member is renamed.
cc_binary(
    name = "demo_main",
    srcs = ["demo_main.cpp"],
    deps = [":demo"],
)

# Generates :format.check (test / lint gate), :format.diff, :format.fix and
# :format.compile_commands (bazel run) over the demo targets.
cpp_format_targets(
    name = "format",
    deps = [
        ":budget",
        ":demo",
        ":demo_main",
    ],
)

# Generates :index.index, a build target whose output (index.index.pb) is the
# merged symbol index of the demo targets: every symbol's declarations,
# definitions and references across both, as byte ranges; :index.db, the same
# index imported into SQLite; and :index.browse, which `bazel run` to serve
# this workspace in the code browser over it.
cpp_index_targets(
    name = "index",
    # //code_browser:smoke_test serves this index over a copy of the sources.
    visibility = ["//code_browser:__pkg__"],
    deps = [
        ":demo",
        ":demo_main",
    ],
)

exports_files(
    [
        "budget.h",
        "demo.cpp",
        "demo.h",
        "demo_main.cpp",
    ],
    visibility = ["//code_browser:__pkg__"],
)

# Reads the merged index back with `cpp_format --dump-index` and asserts the
# cross-target reference: demo_main.cpp's use of Widget::item_count_ resolves
# to the same symbol as its definition in demo.h, both under exec-root-relative
# paths.
sh_test(
    name = "index_test",
    srcs = ["index_test.sh"],
    args = [
        "$(location :index.index)",
        "$(location //cpp_formatting:cpp_format)",
        "$(location demo.h)",
        "$(location demo_main.cpp)",
    ],
    data = [
        "demo.h",
        "demo_main.cpp",
        ":index.index",
        "//cpp_formatting:cpp_format",
    ],
)

# Runs :index.browse the way `bazel run` would (BUILD_WORKSPACE_DIRECTORY set
# to a copy of the demo sources) and checks that the server it starts serves
# that checkout over the index the build imported.
sh_test(
    name = "browse_test",
    srcs = ["browse_test.sh"],
    args = [
        "$(location :index.browse)",
        "$(location //code_browser:http_get)",
        "$(location budget.h)",
        "$(location demo.cpp)",
        "$(location demo.h)",
        "$(location demo_main.cpp)",
    ],
    data = [
        "budget.h",
        "demo.cpp",
        "demo.h",
        "demo_main.cpp",
        ":index.browse",
        "//code_browser:http_get",
    ],
)

# Runs :format.compile_commands the way `bazel run` would and has cpp_format
# consume the resulting compile_commands.json as its compilation database.
sh_test(
    name = "compile_commands_test",
    srcs = ["compile_commands_test.sh"],
    args = [
        "$(location :format.compile_commands)",
        "$(location //cpp_formatting:cpp_format)",
        "$(location //:cpp_format.yaml)",
        "$(location demo_main.cpp)",
    ],
    data = [
        "demo_main.cpp",
        ":format.compile_commands",
        "//:cpp_format.yaml",
        "//cpp_formatting:cpp_format",
    ],
)
