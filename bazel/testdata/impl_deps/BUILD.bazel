load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/testdata:aspect_outputs.bzl", "cpp_format_records", "cpp_index_units")

# Fixture for `implementation_deps`.  A target's CcInfo is what it *exports*,
# and an implementation dep is by definition not exported -- so an aspect that
# derives a target's compile command from its CcInfo alone loses the include
# path below, and meter.cpp does not parse ('gauge.h' file not found).  That is
# why gauge.h sits behind an `includes` directory of its own: next to meter.cpp
# it would be found relative to the including file and prove nothing.
cc_library(
    name = "gauge",
    hdrs = ["include/gauge.h"],
    includes = ["include"],
)

cc_library(
    name = "meter",
    srcs = ["meter.cpp"],
    hdrs = ["meter.h"],
    implementation_deps = [":gauge"],
)

# :format_check_test is the test: building its records runs the emit action for
# meter.cpp, and passing it means the use of Gauge::level_ there was seen with
# gauge.h owned (the aspect propagates along implementation_deps as it does
# along deps).
cpp_format_records(
    name = "format_records",
    deps = [":meter"],
)

sh_test(
    name = "format_check_test",
    srcs = ["//bazel/testdata:aggregate_check_test.sh"],
    args = [
        "$(location //cpp_formatting:aggregate_edits)",
        "$(locations :format_records)",
    ],
    data = [
        ":format_records",
        "//cpp_formatting:aggregate_edits",
    ],
)

# The same for the index aspect; `bazel build //...` builds the unit.
cpp_index_units(
    name = "index_units",
    deps = [":meter"],
)
