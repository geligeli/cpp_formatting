bazel-*
compile_commands.json
**/.nfs*
.bazelrc.local
.claude/settings.local.json
.e2e/

# Bazel caches bind-mounted into the devcontainer (see
# .devcontainer/init-bazel-caches.sh); a symlink when BAZEL_DISK_CACHE /
# BAZEL_REPO_CACHE point at a shared cache.
/.disk_cache
/.bazel_cache
.claude/worktrees/
.cache
# Generated when the e2e harness builds a fixture workspace in place.
e2e/testdata/*/MODULE.bazel.lock
